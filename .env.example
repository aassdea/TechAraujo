# La API se resuelve en el mismo servidor que sirve el frontend.
VITE_API_URL=/techaraujo/backend/api.php
# ID de cliente de tipo "Aplicación web" de Google Identity Services.
# La API PHP usa este mismo valor para validar los tokens recibidos.
VITE_GOOGLE_CLIENT_ID=

# Opcionales si MySQL no usa los valores por defecto de XAMPP.
TECH_DB_HOST=127.0.0.1
TECH_DB_PORT=3306
TECH_DB_NAME=techaraujo
TECH_DB_USER=root
TECH_DB_PASS=
# Base en la nube con SSL (Aiven, TiDB Cloud...): ruta al certificado de la CA.
# Aiven: descargá "ca.pem" y ponelo en backend/ -> TECH_DB_SSL_CA=backend/ca.pem
# TiDB Cloud en Linux/Docker: TECH_DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt
TECH_DB_SSL_CA=

# Envío del PDF por mail (SMTP). Ejemplo con Gmail:
# necesitás activar la verificación en 2 pasos y crear una "contraseña de aplicación"
# en https://myaccount.google.com/apppasswords (NO uses tu contraseña normal).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_cuenta@gmail.com
SMTP_PASS=
SMTP_FROM=tu_cuenta@gmail.com
SMTP_FROM_NAME=TechRepair

# Comparador de precios (Google Shopping vía SerpApi, https://serpapi.com).
# Creá una cuenta gratis, copiá tu "API key" y pegala acá. La clave queda solo en el servidor.
SERPAPI_KEY=
# País de la búsqueda (ar = Argentina).
SHOPPING_GL=ar
# Solo si PHP falla con "SSL certificate problem": ruta a un cacert.pem, por ejemplo
# CURL_CA_BUNDLE=C:\xampp\apache\bin\curl-ca-bundle.crt
